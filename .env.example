# 服务端环境变量示例（复制为 .env.local 使用；.env.local 不入库）
#
# ★ 通常不需要本文件：AI 总结的 LLM 配置在前端右上角「设置」里填写，
#   存本机 localStorage（键 llmSettings），优先级高于这里的兜底配置。
#   本文件仅供部署者设置「全站兜底 Key」——前端未配置时回落到这里。
#
# 注意：不要加 NEXT_PUBLIC_ 前缀——兜底 Key 只在服务端 Route Handler 内读取，不进浏览器 bundle。
# 前端配置的 Key 会随 /api/summarize 请求体发送，服务端只校验不落盘、不回显。

# ---- AI 总结兜底配置（二选一配置；LLM_PROVIDER 选择 provider）----
# provider：deepseek（默认）| qwen（通义千问，兼容模式）
LLM_PROVIDER=deepseek

# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 通义千问（阿里云百炼）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 覆盖默认模型（缺省：deepseek → deepseek-flash；qwen → qwen-plus）
# LLM_MODEL=
